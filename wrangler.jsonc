{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plurmurate-ecologistics",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plurmurate",
      "database_id": "68a74ab5-2d57-4d31-a775-b4cecaad4c21"
    }
  ],
"vars": {
    "X_HOST_HANDLE": "SistersOfVera",
    "X_HOST_USER_ID": "2055384827382145024"
    "DISCORD_CHANNEL_ID": "1343739296372494427"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "plurmur"
    }
  ]
}
